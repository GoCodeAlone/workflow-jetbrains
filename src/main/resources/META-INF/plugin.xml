<idea-plugin>
    <id>com.gocodalone.workflow</id>
    <name>Workflow Engine</name>
    <vendor url="https://github.com/GoCodeAlone">GoCodeAlone</vendor>

    <description><![CDATA[
        <p>IDE support for Workflow Engine configuration files. Compatible with <strong>workflow engine v0.16.4+</strong>.</p>
        <ul>
            <li>YAML schema validation and autocomplete for workflow configs</li>
            <li>Language Server Protocol (LSP) integration via workflow-lsp-server</li>
            <li>wfctl command integration: validate, inspect, init, run, schema</li>
            <li>Live templates for modules, pipelines, steps, triggers, and workflows</li>
        </ul>
        <p>Requires <a href="https://github.com/GoCodeAlone/workflow">Workflow Engine</a> v0.16.4+ and optionally the wfctl CLI.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>
    <depends optional="true" config-file="workflow-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- JSON Schema provider for workflow YAML files -->
        <json.schemaProviderFactory
            implementation="com.gocodalone.workflow.ide.schema.WorkflowSchemaProviderFactory"/>

        <!-- Settings configurable under Tools > Workflow Engine (application-level) -->
        <applicationConfigurable
            parentId="tools"
            instance="com.gocodalone.workflow.ide.settings.WorkflowSettingsConfigurable"
            id="com.gocodalone.workflow.settings"
            displayName="Workflow Engine"/>

        <!-- Project-level settings configurable (nested under application configurable) -->
        <projectConfigurable
            parentId="com.gocodalone.workflow.settings"
            provider="com.gocodalone.workflow.ide.settings.WorkflowProjectSettingsConfigurableProvider"
            id="com.gocodalone.workflow.project.settings"
            displayName="Project Settings"/>

        <!-- Persistent settings state (application-level) -->
        <applicationService
            serviceImplementation="com.gocodalone.workflow.ide.settings.WorkflowSettings"/>

        <!-- Project-level settings (config paths, detection preferences) -->
        <projectService
            serviceImplementation="com.gocodalone.workflow.ide.settings.WorkflowProjectSettings"/>

        <!-- Startup activity for MCP registration prompt -->
        <postStartupActivity
            implementation="com.gocodalone.workflow.ide.WorkflowStartupActivity"/>

        <!-- Live templates for YAML workflow files -->
        <defaultLiveTemplates file="/liveTemplates/workflow.xml"/>
        <liveTemplateContext
            implementation="com.gocodalone.workflow.ide.livetemplate.WorkflowLiveTemplateContext"
            contextId="WORKFLOW_YAML"/>

        <!-- Visual editor tool window -->
        <toolWindow id="Workflow Visual Editor"
                    anchor="right"
                    icon="AllIcons.FileTypes.Diagram"
                    factoryClass="com.gocodalone.workflow.ide.editor.WorkflowVisualEditorToolWindowFactory"/>

        <!-- Editor notification banner for detected workflow files -->
        <editorNotificationProvider
            implementation="com.gocodalone.workflow.ide.editor.WorkflowDetectionNotificationProvider"/>

        <!-- Notification group -->
        <notificationGroup id="Workflow Engine"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
    </extensions>

    <actions>
        <!-- Visual Editor action (in Tools menu, editor tab context menu, and editor popup) -->
        <action id="com.gocodalone.workflow.actions.OpenVisualEditor"
                class="com.gocodalone.workflow.ide.editor.WorkflowVisualEditorAction"
                text="Open Workflow Visual Editor"
                description="Open the workflow visual editor for this YAML file"
                icon="AllIcons.FileTypes.Diagram">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- Mark as Workflow Config (file/directory context menu) -->
        <action id="com.gocodalone.workflow.actions.MarkAsWorkflowConfig"
                class="com.gocodalone.workflow.ide.actions.MarkAsWorkflowConfigAction"
                text="Mark as Workflow Config"
                description="Add this file or directory pattern to Workflow Engine config paths">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <group id="com.gocodalone.workflow.actions.WfctlGroup"
               text="Workflow Engine"
               description="Workflow Engine wfctl commands"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="com.gocodalone.workflow.actions.OpenVisualEditorMenu"
                    class="com.gocodalone.workflow.ide.editor.WorkflowVisualEditorAction"
                    text="Open Visual Editor"
                    description="Open the workflow visual editor for the current file"
                    icon="AllIcons.FileTypes.Diagram"/>

            <separator/>

            <action id="com.gocodalone.workflow.actions.ValidateAction"
                    class="com.gocodalone.workflow.ide.actions.ValidateAction"
                    text="Validate Config"
                    description="Run wfctl template validate on the current file"/>

            <action id="com.gocodalone.workflow.actions.InspectAction"
                    class="com.gocodalone.workflow.ide.actions.InspectAction"
                    text="Inspect Dependencies"
                    description="Run wfctl inspect -deps on the current file"/>

            <separator/>

            <action id="com.gocodalone.workflow.actions.InitAction"
                    class="com.gocodalone.workflow.ide.actions.InitAction"
                    text="Init from Template..."
                    description="Run wfctl template init to scaffold a new workflow config"/>

            <action id="com.gocodalone.workflow.actions.RunAction"
                    class="com.gocodalone.workflow.ide.actions.RunAction"
                    text="Run Workflow"
                    description="Run wfctl run -config on the current file"/>

            <action id="com.gocodalone.workflow.actions.WorkflowSchemaAction"
                    class="com.gocodalone.workflow.ide.actions.WorkflowSchemaAction"
                    text="Show Schema"
                    description="Run wfctl schema to show the workflow config schema"/>

            <action id="com.gocodalone.workflow.actions.WorkflowTemplateValidateAction"
                    class="com.gocodalone.workflow.ide.actions.WorkflowTemplateValidateAction"
                    text="Template Validate"
                    description="Run wfctl template validate on the current file"/>
        </group>
    </actions>
</idea-plugin>
