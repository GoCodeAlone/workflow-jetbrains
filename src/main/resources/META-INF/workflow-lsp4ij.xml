<idea-plugin>
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="workflow-lsp-server"
                name="Workflow LSP"
                factoryClass="com.gocodalone.workflow.ide.lsp.WorkflowLspServerSupportProvider">
            <description><![CDATA[
                Language server for Workflow Engine YAML configuration files.
            ]]></description>
        </server>

        <!-- Static patterns for common workflow config names.
             These cannot reflect per-project configPaths settings — runtime file
             matching is handled by WorkflowLspServerDescriptor.isSupportedFile,
             which also checks project-level glob patterns and content detection. -->
        <fileNamePatternMapping patterns="workflow.yaml;workflow.yml;app.yaml;app.yml;infra.yaml;infra.yml"
                                serverId="workflow-lsp-server"
                                languageId="yaml"/>
    </extensions>
</idea-plugin>
